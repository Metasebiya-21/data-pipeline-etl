# Copy to .env and fill in. Never commit .env.

# MongoDB source
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=coop-customer-management-db
MONGO_COLLECTION=customers
MONGO_CHANGE_STREAM_DB=coop-customer-management-db
MONGO_CHANGE_STREAM_COLLECTION=customers
SYNC_LOOKBACK_MINUTES=1440
CHANGE_STREAM_MAX_SECONDS=60
CHANGE_STREAM_MAX_EVENTS=500
FULL_REFRESH=0
INITIAL_LOAD=0

# Sources for the DAG (one mapped task per source) and scripts/initial_load.py:
# "mongo_db=label,..." - the label is stored in Snowflake as source_database
MONGO_SOURCES=coop-customer-management-db=michu_coop,wegagen-customer-management-db=efoyta_wegagen
DOCS_PER_FILE=25000

# Snowflake target (mongo_snowflake_elt DAG + dbt)
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<service_user>
SNOWFLAKE_PASSWORD=<password>
SNOWFLAKE_DATABASE=LENDING
SNOWFLAKE_LOADER_ROLE=LOADER
SNOWFLAKE_LOAD_WAREHOUSE=LOAD_WH
SNOWFLAKE_TRANSFORMER_ROLE=TRANSFORMER
SNOWFLAKE_TRANSFORM_WAREHOUSE=TRANSFORM_WH
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_BIN=/opt/airflow/dbt_venv/bin/dbt

# Oracle target (mongo_oracle_etl DAG) - only needed for the Oracle DAG
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=oracle:1521/FREEPDB1
ORACLE_TABLE=
